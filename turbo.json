{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "JWT_*",
    "BCRYPT_ROUNDS",
    "PORT",
    "WEB_URL",
    "CORS_ORIGINS",
    "TRUST_PROXY",
    "RATE_LIMIT_PER_MIN",
    "API_INTERNAL_URL",
    "SITE_URL",
    "CI",
    "DATABASE_URL_E2E",
    "AUTH_RATE_LIMIT_PER_MIN",
    "SWAGGER_ENABLED",
    "UPLOAD_DIR",
    "COOKIE_DOMAIN",
    "STORAGE_DRIVER",
    "S3_*",
    "MAIL_TRANSPORT",
    "MAIL_FROM",
    "SMTP_*",
    "STRIPE_*",
    "CRON_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "src/generated/**"],
      "env": ["NEXT_PUBLIC_*", "BUILD_STANDALONE"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@ai-academy/web#test:e2e": {
      "dependsOn": ["build", "@ai-academy/api#build"],
      "cache": false
    }
  }
}
