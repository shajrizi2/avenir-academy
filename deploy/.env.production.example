# Production settings for deploy/docker-compose.prod.yml (docs/DEPLOY.md, step 6).
# Copy to /opt/avenir/deploy/.env.production on the Droplet, fill in, `chmod 600` it.
# It never goes into git (deploy/.gitignore). Values with spaces or <> need quotes.
#
# Generate secrets on the server:
#   openssl rand -hex 32       → POSTGRES_PASSWORD (letters/digits only: it goes into a URL)
#   openssl rand -base64 48    → each JWT_* secret (must be different from each other)

# ---------------------------------------------------------------------------------------
# Domains and images
# ---------------------------------------------------------------------------------------
# Apex domain. Caddy serves it, www.<it> (308 → apex) and api.<it>, with Let's Encrypt.
CADDY_DOMAIN=avenir.academy
# Let's Encrypt account email (expiry warnings).
ACME_EMAIL=you@example.com
# ghcr.io/<github-owner-in-lowercase>. The tag (git SHA) lives in deploy/.image-tag.
IMAGE_REGISTRY=ghcr.io/your-github-user

# ---------------------------------------------------------------------------------------
# Database (Postgres 16 in Docker; DATABASE_URL is built from these in the compose file:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB)
# ---------------------------------------------------------------------------------------
POSTGRES_USER=avenir
POSTGRES_PASSWORD=
POSTGRES_DB=avenir

# ---------------------------------------------------------------------------------------
# API: URLs, CORS, cookies
# ---------------------------------------------------------------------------------------
# Public URL of the web app (links in emails, e.g. password reset).
WEB_URL=https://avenir.academy
# The only browser origin allowed to call the API (comma-separated list).
CORS_ORIGINS=https://avenir.academy
# Refresh cookie domain: shared by avenir.academy and api.avenir.academy.
COOKIE_DOMAIN=.avenir.academy

# ---------------------------------------------------------------------------------------
# Auth (rotating JWT_REFRESH_SECRET signs everyone out; see DEPLOY.md, day-2)
# ---------------------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
BCRYPT_ROUNDS=12
# Per IP per minute: all requests / login, register and password resets.
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=10
# Swagger UI at https://api.avenir.academy/api/docs. Keep false; true only briefly.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------------------
# Material files: Cloudflare R2 bucket "avenir-materials" (private; files are streamed
# through the API, which checks access). Token: Object Read & Write on that bucket only.
# ---------------------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=avenir-materials
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------
# Email: Resend over SMTP (implicit TLS on 465). SMTP_PASS is the Resend API key (re_…).
# ---------------------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM="Avenir Academy <no-reply@avenir.academy>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=

# ---------------------------------------------------------------------------------------
# Backups: nightly pg_dump to the separate private R2 bucket "avenir-backups"
# (deploy/backup/). Use a DIFFERENT token: Object Read & Write on avenir-backups only.
# ---------------------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=avenir-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Cron schedule in TZ (default: 02:30 every night, Albania time).
BACKUP_SCHEDULE=30 2 * * *
TZ=Europe/Tirane
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# ---------------------------------------------------------------------------------------
# Build-time values (NOT read here). They are baked into the web image by
# .github/workflows/deploy.yml from GitHub repository variables:
#   SITE_URL=https://avenir.academy
#   NEXT_PUBLIC_API_URL=https://api.avenir.academy/api/v1
#   NEXT_PUBLIC_GA_ID=G-XXXXXXX   (optional; empty = no analytics, no cookie banner)
# ---------------------------------------------------------------------------------------
