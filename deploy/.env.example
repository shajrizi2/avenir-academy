# Copy to deploy/.env on the server and fill in. Never commit the real file.

# --- Site ---
# The public domain (DNS A/AAAA records must point at this server).
DOMAIN=academy.example.com
# Google Analytics 4 measurement ID; empty = no analytics and no cookie banner.
NEXT_PUBLIC_GA_ID=

# --- Database ---
POSTGRES_USER=academy
# Letters and digits only (it goes into a connection URL): openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=ai_academy

# --- Auth (each: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=

# --- Email (any SMTP provider) ---
MAIL_TRANSPORT=smtp
MAIL_FROM=AI Academy <no-reply@academy.example.com>
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false); 465 = TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Optional ---
# Only for testing the stack locally (e.g. HTTP_PORT=8080, HTTPS_PORT=8443).
# HTTP_PORT=80
# HTTPS_PORT=443
