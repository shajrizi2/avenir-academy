# Local test of the production stack (copy to deploy/.env.local). Not for the server.
CADDY_DOMAIN=localhost
ACME_EMAIL=local@example.com
HTTP_PORT=8088
HTTPS_PORT=8443
# Images built locally: docker build -t local/avenir-api:dev -f apps/api/Dockerfile .
IMAGE_REGISTRY=local
IMAGE_TAG=dev

POSTGRES_USER=avenir
POSTGRES_PASSWORD=localpassword123
POSTGRES_DB=avenir

WEB_URL=https://localhost:8443
CORS_ORIGINS=https://localhost:8443
COOKIE_DOMAIN=
JWT_ACCESS_SECRET=local-access-secret-0123456789abcdefghijklmnop
JWT_REFRESH_SECRET=local-refresh-secret-0123456789abcdefghijklmnop
JWT_RESET_SECRET=local-reset-secret-0123456789abcdefghijklmnopqr
BCRYPT_ROUNDS=10
SWAGGER_ENABLED=false

STORAGE_DRIVER=s3
S3_ENDPOINT=http://fake-r2:9000
S3_REGION=auto
S3_BUCKET=avenir-materials
S3_ACCESS_KEY_ID=local-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_FORCE_PATH_STYLE=true

MAIL_TRANSPORT=console
MAIL_FROM="Avenir Academy <no-reply@localhost>"

BACKUP_S3_ENDPOINT=http://fake-r2:9000
BACKUP_S3_PROVIDER=Other
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_BUCKET=avenir-backups
BACKUP_S3_ACCESS_KEY_ID=local-key
BACKUP_S3_SECRET_ACCESS_KEY=local-secret-key
BACKUP_SCHEDULE=30 2 * * *
TZ=Europe/Tirane
