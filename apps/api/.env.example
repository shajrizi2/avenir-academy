# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (the web app normally proxies, see docs/PLAN.md D3)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails, e.g. password reset links)
WEB_URL=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://academy:academy@localhost:5432/ai_academy?schema=public
# Used only by the e2e tests
DATABASE_URL_TEST=postgresql://academy:academy@localhost:5432/ai_academy_test?schema=public

# --- Auth (use long random strings in production: `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_RESET_SECRET=change-me-reset-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_RESET_TTL=30m
BCRYPT_ROUNDS=12

# --- Uploads (materials) ---
# Folder for uploaded files; relative paths resolve from apps/api. Back it up in production.
UPLOAD_DIR=uploads

# --- Email ---
# console = print emails in the API log (development). smtp = send them (production, any provider).
MAIL_TRANSPORT=console
MAIL_FROM=AI Academy <no-reply@example.com>
SMTP_HOST=
# 587 with SMTP_SECURE=false uses STARTTLS; 465 needs SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Hardening ---
# Login/register/password-reset requests per minute per IP.
AUTH_RATE_LIMIT_PER_MIN=10
# Swagger UI at /api/docs: on by default, off when NODE_ENV=production unless set to true.
# SWAGGER_ENABLED=false
