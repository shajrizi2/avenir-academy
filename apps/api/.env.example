# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (the web app normally proxies, see docs/PLAN.md D3)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in emails, e.g. password reset links)
WEB_URL=http://localhost:3000

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql://academy:academy@localhost:5432/ai_academy?schema=public
# Used only by the e2e tests
DATABASE_URL_TEST=postgresql://academy:academy@localhost:5432/ai_academy_test?schema=public

# --- Auth (use long random strings in production: `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_RESET_SECRET=change-me-reset-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_RESET_TTL=30m
BCRYPT_ROUNDS=12

# Refresh cookie Domain attribute. Empty = host-only (development). Production: .avenir.academy
COOKIE_DOMAIN=

# --- Uploads (materials) ---
# local = files under UPLOAD_DIR (relative paths resolve from apps/api); s3 = an S3-compatible
# bucket (Cloudflare R2 in production, see deploy/.env.production.example).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email ---
# console = print emails in the API log (development). smtp = send them (production, any provider).
MAIL_TRANSPORT=console
MAIL_FROM=AI Academy <no-reply@example.com>
SMTP_HOST=
# 587 with SMTP_SECURE=false uses STARTTLS; 465 needs SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Payments (Stripe Checkout; bank transfer needs no keys) ---
# TEST-mode keys locally (sk_test_…), from https://dashboard.stripe.com/test/apikeys. Never commit them.
# Empty = card checkout answers 503 (bank transfer still works). Production refuses to start
# without both while STRIPE_ENABLED=true.
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…): `stripe listen --forward-to localhost:4000/api/v1/payments/stripe/webhook`
# prints one for local testing; production uses the one from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# true = a fake Stripe client with no network (tests, demos without keys). Never in production.
STRIPE_FAKE=false

# --- Scheduled jobs (reminders, offline-learning emails, hold expiry), in Europe/Tirane ---
CRON_ENABLED=true

# --- Hardening ---
# Login/register/password-reset requests per minute per IP.
AUTH_RATE_LIMIT_PER_MIN=10
# Swagger UI at /api/docs: on by default, off when NODE_ENV=production unless set to true.
# SWAGGER_ENABLED=false
