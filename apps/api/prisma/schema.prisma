// AI Academy data model. Changes require product-owner approval (see CLAUDE.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

/// PENDING: a request waiting for an admin (legacy flow, no payment). PENDING_PAYMENT: a seat is
/// held until the first month is paid (Stripe: 30 minutes, bank transfer: 48 hours). APPROVED:
/// enrolled (the first month is paid, or an admin approved by hand). WAITLISTED: the group was
/// full. EXPIRED: the hold ran out unpaid.
enum EnrollmentStatus {
  PENDING
  PENDING_PAYMENT
  APPROVED
  REJECTED
  CANCELLED
  WAITLISTED
  EXPIRED
}

enum GroupStatus {
  OPEN
  FULL
  RUNNING
  FINISHED
}

enum PaymentMethod {
  STRIPE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  EXPIRED
}

enum EmailType {
  PASSWORD_RESET
  REGISTRATION_CONFIRMED
  LECTURE_REMINDER_24H
  LECTURE_REMINDER_1H
  OFFLINE_LEARNING
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  HOLD_EXPIRING
  HOLD_EXPIRED
  REFUND_ISSUED
  WAITLIST_JOINED
  SEAT_OFFERED
  JOB_LOGIN_CODE
  JOBS_ALERT
  CAMPAIGN
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ModuleStatus {
  LOCKED
  ACTIVE
  PASSED
  FAILED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// Languages of the public marketing site.
enum Locale {
  sq
  en
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  role                 Role             @default(STUDENT)
  /// Public profile shown on the landing page for instructors.
  avatarUrl            String?
  title                String?
  bio                  String?
  /// Students may opt out of the offline-learning emails only; reminders always go out.
  offlineEmailsEnabled Boolean          @default(true)
  createdAt            DateTime         @default(now())
  enrollments          Enrollment[]
  progress             ModuleProgress[]
  attempts             TestAttempt[]
  attendance           Attendance[]
  teaching             Module[]         @relation("ModuleInstructor")
  groups               Group[]          @relation("GroupInstructor")
  lessonProgress       LessonProgress[]
  emails               EmailLog[]
  confirmedPayments    Payment[]        @relation("PaymentConfirmedBy")
}

model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  summary        String
  description    String
  /// Albanian versions for the /sq landing page; null falls back to English (PLAN D11).
  titleSq        String?
  summarySq      String?
  descriptionSq  String?
  coverUrl       String?
  startDate      DateTime?
  isPublished    Boolean      @default(false)
  /// Price per month (= per module), in minor units. listPriceCents is the struck-through
  /// standard price shown next to it (null = no discount shown). Editable in admin.
  priceCents     Int          @default(8900)
  listPriceCents Int?         @default(15000)
  currency       String       @default("EUR")
  modules        Module[]
  enrollments    Enrollment[]
  groups         Group[]
}

model Module {
  id            String           @id @default(cuid())
  courseId      String
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  description   String
  /// Albanian versions; null falls back to English (PLAN D11).
  titleSq       String?
  descriptionSq String?
  durationWeeks Int              @default(4)
  instructorId  String?
  instructor    User?            @relation("ModuleInstructor", fields: [instructorId], references: [id])
  sessions      LiveSession[]
  materials     Material[]
  lessons       Lesson[]
  test          Test?
  progress      ModuleProgress[]
  payments      Payment[]

  @@unique([courseId, order])
}

/// A cohort of at most `capacity` students taking a course together on a weekly schedule.
/// Times are local to `timezone`; sessions are generated from the schedule (12 per module).
model Group {
  id               String        @id @default(cuid())
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name             String
  startDate        DateTime      @db.Date
  endDate          DateTime      @db.Date
  /// Days of the week with a live lecture: 0 = Sunday … 6 = Saturday.
  weekdays         Int[]
  /// Local start time, "HH:mm".
  startTime        String
  durationMin      Int           @default(120)
  timezone         String        @default("Europe/Tirane")
  capacity         Int           @default(10)
  status           GroupStatus   @default(OPEN)
  instructorId     String?
  instructor       User?         @relation("GroupInstructor", fields: [instructorId], references: [id])
  /// Default Google Meet link copied to generated sessions.
  meetUrl          String?
  /// Days on which the offline-learning email may go out when there is no lecture (default: all but Sunday).
  offlineEmailDays Int[]         @default([1, 2, 3, 4, 5, 6])
  createdAt        DateTime      @default(now())
  enrollments      Enrollment[]
  sessions         LiveSession[]

  @@index([courseId, status])
}

model Enrollment {
  id            String           @id @default(cuid())
  userId        String
  courseId      String
  groupId       String?
  status        EnrollmentStatus @default(PENDING)
  note          String?
  /// While PENDING_PAYMENT: the seat is held until then.
  holdExpiresAt DateTime?
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
  user          User             @relation(fields: [userId], references: [id])
  course        Course           @relation(fields: [courseId], references: [id])
  group         Group?           @relation(fields: [groupId], references: [id])
  payments      Payment[]

  @@unique([userId, courseId])
  @@index([groupId, status])
}

/// One payment covers one month (= one module) of one enrollment. A month is paid when a
/// payment for it is CONFIRMED (Stripe webhook or an admin confirming a bank transfer).
model Payment {
  id                    String        @id @default(cuid())
  enrollmentId          String
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId              String
  module                Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  amountCents           Int
  currency              String
  provider              PaymentMethod
  status                PaymentStatus @default(PENDING)
  /// Shown to the student; the bank-transfer reference they must quote.
  reference             String        @unique
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  stripeChargeId        String?
  receiptUrl            String?
  /// While PENDING: the payment (and, for a first month, the seat) expires then.
  holdExpiresAt         DateTime?
  note                  String?
  confirmedAt           DateTime?
  confirmedById         String?
  confirmedBy           User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  failedAt              DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([enrollmentId, moduleId])
  @@index([status, holdExpiresAt])
  @@index([provider, status])
}

/// Stripe webhook events already processed, so a redelivered event is handled once.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

model ModuleProgress {
  id         String       @id @default(cuid())
  userId     String
  moduleId   String
  status     ModuleStatus @default(LOCKED)
  unlockedAt DateTime?
  passedAt   DateTime?
  user       User         @relation(fields: [userId], references: [id])
  module     Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model LiveSession {
  id          String       @id @default(cuid())
  moduleId    String
  /// The cohort this lecture belongs to (null only for sessions created before groups existed).
  groupId     String?
  title       String
  startsAt    DateTime
  durationMin Int          @default(90)
  meetUrl     String
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  group       Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance  Attendance[]

  @@index([groupId, startsAt])
  @@index([startsAt])
}

model Attendance {
  sessionId String
  userId    String
  present   Boolean     @default(true)
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@id([sessionId, userId])
}

model Material {
  id       String  @id @default(cuid())
  moduleId String
  /// Optionally attached to one offline lesson of the module.
  lessonId String?
  title    String
  url      String
  kind     String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
}

/// Offline learning between live lectures: Markdown content and an optional video per module.
model Lesson {
  id           String           @id @default(cuid())
  moduleId     String
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order        Int
  title        String
  /// Markdown, rendered safely (no raw HTML).
  content      String
  /// YouTube or Vimeo page URL; embedded on the lesson page.
  videoUrl     String?
  estimatedMin Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  materials    Material[]
  progress     LessonProgress[]

  @@unique([moduleId, order])
}

model LessonProgress {
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

/// Every email the platform sends. `uniqueKey` makes sends idempotent: a cron job that runs
/// twice, or a restart, never emails the same thing twice.
model EmailLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  to        String
  type      EmailType
  uniqueKey String      @unique
  subject   String
  status    EmailStatus @default(PENDING)
  error     String?
  meta      Json?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model Test {
  id           String        @id @default(cuid())
  moduleId     String        @unique
  title        String
  passMark     Int           @default(70)
  timeLimitMin Int           @default(45)
  maxAttempts  Int           @default(2)
  opensAt      DateTime
  closesAt     DateTime
  isPublished  Boolean       @default(false)
  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    Question[]
  attempts     TestAttempt[]
}

model Question {
  id      String       @id @default(cuid())
  testId  String
  order   Int
  type    QuestionType
  text    String
  points  Int          @default(1)
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  options Option[]
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id          String        @id @default(cuid())
  testId      String
  userId      String
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  scorePct    Int?
  passed      Boolean?
  answers     Json
  test        Test          @relation(fields: [testId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
}

/// Real student testimonials for the landing page. Never seed or invent these.
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  quote       String
  avatarUrl   String?
  isPublished Boolean  @default(false)
  locale      Locale
  createdAt   DateTime @default(now())

  @@index([locale, isPublished])
}

/// Singleton row (id = 1) with landing-page values the team can change without a deploy.
model SiteSettings {
  id                  Int       @id @default(1)
  nextCohortStart     DateTime?
  scheduleSq          String?
  scheduleEn          String?
  seatsTotal          Int?
  /// Whole currency units (e.g. 150 = 150 EUR). Null shows "contact us".
  priceAmount         Int?
  priceCurrency       String    @default("EUR")
  priceNoteSq         String?
  priceNoteEn         String?
  contactEmail        String?
  contactPhone        String?
  /// International format without "+" or spaces, used for https://wa.me/<number>.
  whatsappNumber      String?
  /// Payment methods offered at checkout (Stripe also needs STRIPE_* set on the server).
  stripeEnabled       Boolean   @default(true)
  bankTransferEnabled Boolean   @default(true)
  /// Bank transfer details shown to students (placeholders until the team fills them in).
  bankBeneficiary     String?
  bankIban            String?
  bankName            String?
  bankSwift           String?
  /// The job board is visible at "/" only once this is on (PLAN D36); until then "/" shows /training.
  jobBoardPublic      Boolean   @default(false)
  updatedAt           DateTime  @updatedAt
}

// ---- Job board (PLAN D36) ----

/// Where a job was read from: a company's career-page system, or a remote job board's feed.
enum JobSourceKind {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  REMOTEOK
  JOBICY
  HIMALAYAS
}

enum JobCompanyStatus {
  ACTIVE
  DISABLED
  BLOCKED
}

/// OPEN: shown on the board. CLOSED: gone from its sources, a dead link or too old. HIDDEN:
/// reported by users. REJECTED: failed the remote, Kosovo-eligibility or scam rules.
enum JobStatus {
  OPEN
  CLOSED
  HIDDEN
  REJECTED
}

enum JobCategory {
  ENGINEERING
  AI_DATA
  MARKETING
  DESIGN
  PRODUCT
  SALES
  SUPPORT
  WRITING
  FINANCE_ADMIN
  HR
  OTHER
}

enum JobContract {
  EMPLOYEE
  CONTRACTOR
  UNKNOWN
}

/// Why someone in Kosovo can apply: the tag shown under the job.
enum JobRegion {
  WORLDWIDE
  EUROPE
  BALKANS
  CONTRACT_ANYWHERE
  GLOBAL_EMPLOYER
}

enum JobCloseReason {
  MISSING_FROM_SOURCE
  DEAD_LINK
  TOO_OLD
  MANUAL
}

enum JobBlockKind {
  COMPANY
  DOMAIN
}

/// A company whose jobs appear on the board. With `ats` + `boardToken` its career page is read
/// directly every morning; companies seen only on job boards have neither.
model JobCompany {
  id             String           @id @default(cuid())
  /// Normalised name ("acme labs"), unique: how jobs from different sources meet.
  key            String           @unique
  name           String
  ats            JobSourceKind?
  boardToken     String?
  website        String?
  status         JobCompanyStatus @default(ACTIVE)
  /// "seed", "admin" or the source that revealed the career page (e.g. "REMOTEOK").
  discoveredFrom String?
  lastFetchedAt  DateTime?
  failCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  jobs           Job[]

  @@unique([ats, boardToken])
  @@index([status, ats])
}

/// Health of each job-board feed. A feed failing 3 runs in a row is switched off for a week.
model JobFeed {
  kind          JobSourceKind @id
  enabled       Boolean       @default(true)
  failCount     Int           @default(0)
  lastSuccessAt DateTime?
  lastError     String?
  pausedUntil   DateTime?
}

model Job {
  id             String          @id @default(cuid())
  companyId      String
  company        JobCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  /// company key | cleaned title | region: the same job seen on several sources.
  fingerprint    String
  category       JobCategory
  contract       JobContract     @default(UNKNOWN)
  region         JobRegion
  /// Location text as the source gave it (shown nowhere, kept to explain decisions).
  locationText   String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  /// YEAR, MONTH, WEEK or HOUR.
  salaryPeriod   String?
  /// One or two plain-text sentences about the job, shown under the title (PLAN D38).
  summary        String?
  applyUrl       String
  applySource    JobSourceKind
  status         JobStatus
  /// Which rule rejected the job, or which made it eligible (e.g. "eligible:worldwide").
  rule           String
  scamScore      Int             @default(0)
  scamReasons    String[]
  postedAt       DateTime
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  linkCheckedAt  DateTime?
  closedAt       DateTime?
  closeReason    JobCloseReason?
  listings       JobListing[]

  @@index([status, postedAt])
  @@index([status, category, postedAt])
  @@index([fingerprint])
  @@index([companyId])
}

/// One place a job was seen. A job closes when every listing has been missing for 2 runs.
model JobListing {
  id         String        @id @default(cuid())
  jobId      String
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source     JobSourceKind
  externalId String
  sourceUrl  String
  lastSeenAt DateTime      @default(now())
  missedRuns Int           @default(0)

  @@unique([source, externalId])
  @@index([jobId])
}

/// A job-board account: an email, signed in with a code (PLAN D36). Separate from User.
model JobSeeker {
  id               String                   @id @default(cuid())
  email            String                   @unique
  /// Agreed to emails about opportunities from Avenir (the tick in the sign-in pop-up).
  marketingConsent Boolean                  @default(false)
  consentAt        DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime                 @default(now())
  lastSeenAt       DateTime                 @default(now())
  sessions         JobSeekerSession[]
  campaignEmails   EmailCampaignRecipient[]

  @@index([lastSeenAt])
}

/// A 6-digit login code, stored hashed. Valid 10 minutes, once, 5 wrong tries.
model JobSeekerCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A signed-in device. The cookie holds the token; only its hash is stored.
model JobSeekerSession {
  id          String    @id @default(cuid())
  jobSeekerId String
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([jobSeekerId])
}

/// Companies (by key) and apply-link domains whose jobs are never published.
model JobBlock {
  id        String       @id @default(cuid())
  kind      JobBlockKind
  value     String
  reason    String
  createdAt DateTime     @default(now())

  @@unique([kind, value])
}

/// The log of each daily run.
model JobRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// RUNNING, OK or FAILED.
  status     String
  stats      Json?
  errors     Json?

  @@index([startedAt])
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

/// An email to every job seeker who agreed to hear from Avenir (PLAN D37). Sent a little at a
/// time by the scheduler, within the daily email limit.
model EmailCampaign {
  id          String                   @id @default(cuid())
  subject     String
  body        String
  status      CampaignStatus           @default(DRAFT)
  createdById String?
  createdAt   DateTime                 @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  recipients  EmailCampaignRecipient[]

  @@index([status])
}

/// Who a campaign goes to, fixed when sending starts; `sentAt` marks each one done.
model EmailCampaignRecipient {
  campaignId  String
  jobSeekerId String
  sentAt      DateTime?
  failed      Boolean       @default(false)
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  jobSeeker   JobSeeker     @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@id([campaignId, jobSeekerId])
  @@index([campaignId, sentAt])
}
