# Where the Next.js server reaches the NestJS API (used for server-side fetches and the /api/v1 proxy)
API_INTERNAL_URL=http://localhost:4000/api/v1

# Public base URL of the site (canonical links, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXX). Empty = no analytics and no cookie banner.
# GA loads only after a visitor accepts the banner. Read at build time.
NEXT_PUBLIC_GA_ID=
